rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'donghoic1@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdminEmail() || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdminEmail();
    }

    // Products (Video, Audio, Gallery, Student Works)
    match /products/{productId} {
      allow get: if resource.data.isPublished == true || isAdmin();
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Competitions
    match /competitions/{competitionId} {
      allow get: if resource.data.isPublished == true || isAdmin();
      allow list: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Media library
    match /media/{mediaId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site settings
    match /site_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Homepage configuration
    match /homepage_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
